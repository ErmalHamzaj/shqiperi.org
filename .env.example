# Copy this file to .env.local and fill in your key.

# Anthropic API key — powers the AI search + live web search.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-haiku-4-5 — cheapest/fastest).
# For higher-quality answers, switch to Sonnet:
# SHQIPERI_MODEL=claude-sonnet-5
